# 征信服务数字人 — nginx 站点模板（__DOMAIN__ 换成实际域名，放到 /etc/nginx/conf.d/__DOMAIN__.conf）
# 证书：先只启用 80 段并 reload，再
#   certbot certonly --webroot -w /var/www/certbot-zhengxin -d __DOMAIN__ --deploy-hook "systemctl reload nginx"
#
# 两种 443 布局二选一：
#  A) nginx 直接监听 443：用下方 A 段。
#  B) 443 已被 stream 模块按 SNI 分流（ssl_preread）：在 stream 的 map 里加一行
#     "__DOMAIN__ 127.0.0.1:9460;"，用下方 B 段（本地 TLS 后端）。
#     注意：B 布局下 nginx 看到的来源地址都是 127.0.0.1，应用无法按访客 IP 限流（相当于全局限流），
#     除非 stream 层对所有后端启用 proxy_protocol。

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot-zhengxin; }
    location / { return 301 https://$host$request_uri; }
}

server {
    # A) listen 443 ssl http2;  listen [::]:443 ssl http2;
    # B)
    listen 127.0.0.1:9460 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 20m;   # 播单导入等上传；语音识别在浏览器本地完成，不上传音频

    location / {
        proxy_pass http://127.0.0.1:43200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;   # 只传 nginx 亲眼看到的地址，不沿用客户端自带的值
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_buffering off;          # 对话流式返回、播单 SSE
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
