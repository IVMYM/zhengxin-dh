# 征信服务数字人 — nginx 站点模板。把 __DOMAIN__ 换成实际域名后放到 /etc/nginx/conf.d/。
# 证书：先只启用 80 段，certbot certonly --webroot -w /var/www/certbot -d __DOMAIN__，再启用 443 段。
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:zhengxin_ssl:5m;

    client_max_body_size 20m;   # 播单导入等上传；语音识别在浏览器本地完成，不上传音频

    location / {
        proxy_pass http://127.0.0.1:43200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;   # 只传 nginx 亲眼看到的地址，不沿用客户端自带的值
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;          # 对话流式返回、播单 SSE
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
