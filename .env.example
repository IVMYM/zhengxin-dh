# 复制为 .env 后按需填写（.env 已在 .gitignore 中，切勿提交）。全部可选：不填时只用本地知识库作答。
# Copy to .env and fill in. Every value is optional; without an LLM the kiosk answers from the built-in KB.

# ---- 大模型（OpenAI 兼容接口）/ LLM (OpenAI-compatible) ----
# 只填下面三项时，行为与原来完全一致（一个接口）。
LLM_BASE_URL=https://your-llm-host.example.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-model-name
# LLM_MODE=kb-first            # kb-first（默认）| always
# LLM_FIRST_MS=12000           # 等首字上限（毫秒）。多模型时超时则换下一个；全部失败再回落知识库
# LLM_TIMEOUT_MS=20000         # 单次整句上限（毫秒）
# LLM_EXTRA_BODY={"reasoning_effort":"low"}

# 模型轮询（可选）。取消下面两行注释即启用；启用后以 LLM_MODELS 为准，不再用上面的 LLM_BASE_URL / LLM_MODEL。
# 密钥只放在环境变量里，用 apiKeyEnv 引用，不要把密钥写进 JSON。
# 失败（HTTP 429/5xx、连不上、首字超时）会冷却该模型再换下一个：有 Retry-After 就按其等待，否则约 60 秒（最长 10 分钟）。
# AMD Token Factory 免费模型仅供开发/测试：同一账号约 20 次/分钟，模型有时返回 429（model_concurrency_rate_limit_exceeded）。
# AMD_API_KEY=your-amd-api-key
# LLM_MODELS=[{"baseUrl":"https://api.ifm.ai/v1","apiKeyEnv":"LLM_API_KEY","model":"IFM/K2-Horizon-375B-A23B","extra":{"reasoning_effort":"low"}},{"baseUrl":"https://developer.amd.com.cn/radeon/api/v1","apiKeyEnv":"AMD_API_KEY","model":"DeepSeek-V4-Flash","extra":{}},{"baseUrl":"https://developer.amd.com.cn/radeon/api/v1","apiKeyEnv":"AMD_API_KEY","model":"DeepSeek-V4.1-Flash","extra":{}},{"baseUrl":"https://developer.amd.com.cn/radeon/api/v1","apiKeyEnv":"AMD_API_KEY","model":"MiMo-V2.6-Flash","extra":{}},{"baseUrl":"https://developer.amd.com.cn/radeon/api/v1","apiKeyEnv":"AMD_API_KEY","model":"Qwen3.8-Flash-Next","extra":{}},{"baseUrl":"https://developer.amd.com.cn/radeon/api/v1","apiKeyEnv":"AMD_API_KEY","model":"GLM-5.3-Flash","extra":{}}]

# ---- 语音合成 / TTS ----
# TTS_VOICE_KEY=female         # female（晓晓）| female2（晓伊）
# TTS_TIMEOUT_MS=8000
# PYTHON=/usr/bin/python3      # 指定装了 edge-tts 的 Python

# ---- 服务 / Server ----
# PORT=43200
# HOST=0.0.0.0
# ATTRACT_AFTER_SEC=60

# ---- GPU 口型服务（可选）/ Optional MuseTalk lip-sync service ----
# LIPSYNC_URL=http://<gpu-host>:8787

# 智能体工具（可选）
# WEATHER_CITY=贵阳
# AGENT_TOOLS=1
# TOOL_TIMEOUT_MS=3000
# 联网搜索（Tavily，可选）
# TAVILY_API_KEY=
# WEB_SEARCH_DAILY_LIMIT=30
# WEB_SEARCH_TIMEOUT_MS=5000
